{
  "config": {
    "extends": ".markdownlint.json"
  },
  "globs": [
    "**/*.md",
    "!**/node_modules/**",
    "!**/.vitepress/**",
    "!**/dist/**",
    "!**/tests/**/TestData/**"
  ],
  "ignores": [
    "**/node_modules/**",
    "**/.vitepress/**",
    "**/dist/**",
    "**/tests/**/TestData/**"
  ],
  "fix": false
}
